{
  "name": "Mistis AI",
  "image": "mcr.microsoft.com/devcontainers/python:3-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Mistis AI", "onAutoForward": "openPreview" }
  },
  "postAttachCommand": "nohup python3 -m http.server 8000 --bind 0.0.0.0 > /tmp/mistis-server.log 2>&1 &",
  "customizations": {
    "vscode": { "settings": { "terminal.integrated.defaultProfile.linux": "bash" } }
  }
}
